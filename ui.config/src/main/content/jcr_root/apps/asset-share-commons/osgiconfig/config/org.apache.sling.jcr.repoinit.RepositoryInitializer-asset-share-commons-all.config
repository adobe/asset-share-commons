scripts=["
create service user asset-share-commons-email-service with forced path system/cq:services/asset-share-commons

create service user asset-share-commons-mimetype-service with forced path system/cq:services/asset-share-commons

remove ACE for asset-share-commons-mimetype-service
    allow jcr:read on /libs/dam/gui/content/assets/jcr:content/mimeTypeLookup
end

set principal ACL for asset-share-commons-mimetype-service
    allow jcr:read on /libs/dam/gui/content/assets/jcr:content/mimeTypeLookup
end

create path /conf/asset-share-commons(sling:Folder)
"]

