    },
    "subpage": {
      "jcr:primaryType": "cq:Page",
      "jcr:content": {
        "jcr:primaryType": "cq:PageContent"
      }
    }
  },
  "invalid-contexthub": {
    "jcr:primaryType": "cq:Page",
    "jcr:content": {
      "jcr:primaryType": "cq:PageContent",
      "cq:contextHubPath": "/content/contexthub/invalid"
    },
    "subpage": {
      "jcr:primaryType": "cq:Page",
      "jcr:content": {
        "jcr:primaryType": "cq:PageContent"
      }
    }
  },
  "valid-contexthub": {
    "jcr:primaryType": "cq:Page",
    "jcr:content": {
      "jcr:primaryType": "cq:PageContent",
      "cq:contextHubPath": "/content/contexthub/valid"
    },
    "subpage": {
      "jcr:primaryType": "cq:Page",
      "jcr:content": {
        "jcr:primaryType": "cq:PageContent"
      }
    }
  },
  "contexthub": {
    "jcr:primaryType": "nt:folder",
    "invalid": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "invalid/resource/type"
    },
    "valid": {
      "jcr:primaryType": "nt:unstructured",
      "sling:resourceType": "granite/contexthub/cloudsettings/components/baseconfiguration"
    }
  },
  "action-tests": {
    "jcr:primaryType": "cq:Page",
    "jcr:content": {
      "jcr:primaryType": "cq:PageContent",
      "sling:resourceType": "asset-share-commons/components/structure/search-page",
      "jcr:language": "fr",
      "config": {
        "jcr:primaryType": "nt:unstructured",
        "actions": {
          "jcr:primaryType": "nt:unstructured",
          "download": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": true
          },
          "license": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": true
          },
          "share": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": true
          },
          "cart": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": true
          }
        },
        "asset-details": {
          "jcr:primaryType": "nt:unstructured",
          "selector": "my-custom-selector",
          "assetReferenceById": true,
          "placeholderPath": "/content/action-tests/placeholder.png"
        }
      }
    },
    "placeholder.png": {
      "jcr:primaryType": "nt:unstructured"
    },
    "actions": {
      "jcr:primaryType": "nt:unstructured",
      "download.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      },
      "downloads.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      },
      "license.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      },
      "share.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      },
      "cart.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      }
    }
  },
  "action-tests-cart-disabled": {
    "jcr:primaryType": "cq:Page",
    "jcr:content": {
      "jcr:primaryType": "cq:PageContent",
      "sling:resourceType": "asset-share-commons/components/structure/search-page",
      "config": {
        "jcr:primaryType": "nt:unstructured",
        "actions": {
          "jcr:primaryType": "nt:unstructured",
          "download": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": true
          }
        }
      }
    },
    "actions": {
      "jcr:primaryType": "nt:unstructured",
      "download.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      }
    }
  },
  "action-tests-cart-value": {
    "jcr:primaryType": "cq:Page",
    "jcr:content": {
      "jcr:primaryType": "cq:PageContent",
      "sling:resourceType": "asset-share-commons/components/structure/search-page",
      "config": {
        "jcr:primaryType": "nt:unstructured",
        "actions": {
          "jcr:primaryType": "nt:unstructured",
          "download": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": "cart"
          },
          "cart": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": true
          }
        }
      }
    },
    "actions": {
      "jcr:primaryType": "nt:unstructured",
      "download.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      },
      "cart.partial.html": {
        "jcr:primaryType": "nt:unstructured"
      }
    }
  },
  "action-tests-unrecognized-value": {
    "jcr:primaryType": "cq:Page",
    "jcr:content": {
      "jcr:primaryType": "cq:PageContent",
      "sling:resourceType": "asset-share-commons/components/structure/search-page",
      "config": {
        "jcr:primaryType": "nt:unstructured",
        "actions": {
          "jcr:primaryType": "nt:unstructured",
          "download": {
            "jcr:primaryType": "nt:unstructured",
            "enabled": "garbage-value"
          }
        }
      },
      "actions": {
        "jcr:primaryType": "nt:unstructured",
        "download": {
          "jcr:primaryType": "nt:unstructured"
        }
      }
    }
  },
  "root-tree": {
    "jcr:primaryType": "cq:Page",
    "jcr:content": {
      "jcr:primaryType": "cq:PageContent",
      "sling:resourceType": "asset-share-commons/components/structure/search-page"
    },
    "sub": {
      "jcr:primaryType": "cq:Page",
      "jcr:content": {
        "jcr:primaryType": "cq:PageContent",
        "sling:resourceType": "some/other/type"
